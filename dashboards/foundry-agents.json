{
  "uid": "foundry-agent-operations",
  "title": "Foundry - Agent operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "azure",
    "ai-observability"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Agent run latency",
      "type": "timeseries",
      "description": "Requires the documented telemetry contract. No data is not evidence of health. Latency percentiles reflect retained spans.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "let selectedAgent = url_decode(\"${agent:percentencode}\");\nunion AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where tostring(Properties[\"gen_ai.operation.name\"]) == \"invoke_agent\"\n| extend Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| where selectedAgent in (\"\", \"*\") or Agent =~ selectedAgent\n| summarize P50_ms = percentile(DurationMs, 50),\n    P95_ms = percentile(DurationMs, 95),\n    P99_ms = percentile(DurationMs, 99)\n    by bin(TimeGenerated, $__interval), Agent\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2500
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*P50_ms.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*P95_ms.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*P99_ms.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "Agent runs per interval and failures",
      "type": "timeseries",
      "description": "Each point is a time-bucket count, not the total for the selected range. Observed and failed runs use separate axes; counts retain ItemCount sampling weights.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "let selectedAgent = url_decode(\"${agent:percentencode}\");\nunion AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where tostring(Properties[\"gen_ai.operation.name\"]) == \"invoke_agent\"\n| extend Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| where selectedAgent in (\"\", \"*\") or Agent =~ selectedAgent\n| summarize ObservedRuns = sum(ItemCount),\n    FailedRuns = sumif(ItemCount, Success == false)\n    by bin(TimeGenerated, $__interval), Agent\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*ObservedRuns.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*FailedRuns.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Tool performance",
      "type": "table",
      "description": "Requires the documented telemetry contract. No data is not evidence of health. Latency percentiles reflect retained spans. Not filtered by the agent variable.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "union AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where tostring(Properties[\"gen_ai.operation.name\"]) == \"execute_tool\"\n| extend Tool = tostring(Properties[\"gen_ai.tool.name\"])\n| summarize ObservedCalls = sum(ItemCount),\n    FailedCalls = sumif(ItemCount, Success == false),\n    P95_ms = percentile(DurationMs, 95) by Tool\n| order by P95_ms desc\n",
            "resultFormat": "table",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^P95_ms$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "title": "Model token usage and missing usage spans",
      "type": "timeseries",
      "description": "Input/output token totals are derived from retained model spans. Missing usage spans use the right axis; absent usage is not evidence of zero token consumption. Not filtered by the agent variable.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "let ModelSpans = materialize(\n    union AppRequests, AppDependencies\n    | where $__timeFilter(TimeGenerated)\n    | extend Operation = tostring(Properties[\"gen_ai.operation.name\"])\n    | where Operation in (\"chat\", \"text_completion\", \"invoke_agent\")\n    | extend Model = tostring(Properties[\"gen_ai.response.model\"]),\n        InputTokens = tolong(Properties[\"gen_ai.usage.input_tokens\"]),\n        OutputTokens = tolong(Properties[\"gen_ai.usage.output_tokens\"])\n);\nlet TracesWithModelUsage = ModelSpans\n| where Operation in (\"chat\", \"text_completion\")\n| where isnotnull(InputTokens) or isnotnull(OutputTokens)\n| distinct OperationId;\nModelSpans\n| where Operation != \"invoke_agent\" or OperationId !in (TracesWithModelUsage)\n| where Operation != \"invoke_agent\"\n    or isnotnull(InputTokens) or isnotnull(OutputTokens) or Success != false\n| summarize InputTokens = sum(InputTokens * ItemCount),\n    OutputTokens = sum(OutputTokens * ItemCount),\n    MissingUsageSpans = countif(isnull(InputTokens) or isnull(OutputTokens))\n    by bin(TimeGenerated, $__interval), Model\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*InputTokens.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*OutputTokens.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*MissingUsageSpans.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Failed operations - trace IDs",
      "type": "table",
      "description": "Requires the documented telemetry contract. No data is not evidence of health. Latency percentiles reflect retained spans. Not filtered by the agent variable.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "union AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where Success == false\n| where isnotempty(tostring(Properties[\"gen_ai.operation.name\"]))\n| project TimeGenerated, OperationId, Name, ResultCode, DurationMs\n| order by TimeGenerated desc\n| take 100\n",
            "resultFormat": "table",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^OperationId$/"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this operation in Azure Logs",
                    "url": "https://portal.azure.com/#blade/Microsoft_Azure_Monitoring_Logs/LogsBlade/resourceId/${workspaceResourceId:percentencode}/source/LogsBlade.AnalyticsShareLinkToQuery/q/AppRequests%20%7C%20where%20OperationId%20%3D%3D%20%27${__value.raw}%27%20%7C%20union%20%28AppDependencies%20%7C%20where%20OperationId%20%3D%3D%20%27${__value.raw}%27%29%20%7C%20project%20TimeGenerated%2C%20OperationId%2C%20ParentId%2C%20Name%2C%20ResultCode%2C%20Success%2C%20DurationMs%20%7C%20order%20by%20TimeGenerated%20asc/isQueryBase64Compressed/false",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^TimeGenerated$/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time"
              },
              {
                "id": "custom.width",
                "value": 145
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^OperationId$/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^Name$/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Operation name"
              },
              {
                "id": "custom.width",
                "value": 145
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^ResultCode$/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Result"
              },
              {
                "id": "custom.width",
                "value": 85
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^DurationMs$/"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Duration"
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "title": "Observed instrumentation",
      "type": "timeseries",
      "description": "Counts of observed and recognized spans, not a coverage percentage. A completely silent workspace cannot establish telemetry health. Not filtered by the agent variable.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "union AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| extend Operation = tostring(Properties[\"gen_ai.operation.name\"]),\n    Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| summarize ObservedSpans = sum(ItemCount),\n    GenAISpans = sumif(ItemCount, isnotempty(Operation)),\n    AgentRuns = sumif(ItemCount, Operation == \"invoke_agent\"),\n    UnnamedAgentRuns = sumif(ItemCount, Operation == \"invoke_agent\" and isempty(Agent))\n    by bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Evaluation results (optional custom events)",
      "type": "table",
      "description": "Requires the documented telemetry contract. No data is not evidence of health. Latency percentiles reflect retained spans. Not filtered by the agent variable.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "AppEvents\n| where $__timeFilter(TimeGenerated)\n| where Name == \"obs.evaluation\"\n| extend Evaluator = tostring(Properties[\"obs.evaluator.name\"]),\n    Score = todouble(Properties[\"obs.evaluation.score\"]),\n    Passed = tobool(Properties[\"obs.evaluation.passed\"])\n| summarize EvaluatedSamples = count(), AverageScore = avg(Score),\n    PassedSamples = countif(Passed == true),\n    FailedSamples = countif(Passed == false),\n    InvalidSamples = countif(isnull(Score) or isnull(Passed)) by Evaluator\n| extend ValidSamples = PassedSamples + FailedSamples\n| extend PassRatePercent = iff(ValidSamples > 0,\n    100.0 * todouble(PassedSamples) / todouble(ValidSamples), real(null))\n| project Evaluator, EvaluatedSamples, PassRatePercent, AverageScore,\n    PassedSamples, FailedSamples, InvalidSamples\n| order by Evaluator asc\n",
            "resultFormat": "table",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "title": "Dependency performance",
      "type": "table",
      "description": "Client-observed calls and latency to external dependencies. Hostnames in Target are telemetry metadata; do not emit secrets or customer data there. Not filtered by the agent variable.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "AppDependencies\n| where $__timeFilter(TimeGenerated)\n| extend Dependency = tostring(Target), DependencyType = tostring(Type)\n| summarize ObservedCalls = sum(ItemCount),\n    FailedCalls = sumif(ItemCount, Success == false),\n    P95_ms = percentile(DurationMs, 95)\n    by DependencyType, Dependency\n| order by FailedCalls desc, P95_ms desc\n",
            "resultFormat": "table",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "title": "Agent summary - selected period",
      "type": "stat",
      "description": "Whole-period figures over retained invoke_agent spans for the selected agent. Runs are weighted by ItemCount, the failure rate uses runs with a known outcome, and p95 is taken over retained spans without sampling weights. No data is not evidence of health: the agent may be idle, sampled out or uninstrumented. Threshold colours mirror the default alerts.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "let selectedAgent = url_decode(\"${agent:percentencode}\");\nunion AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where tostring(Properties[\"gen_ai.operation.name\"]) == \"invoke_agent\"\n| extend Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| where selectedAgent in (\"\", \"*\") or Agent =~ selectedAgent\n| summarize Runs = sum(ItemCount),\n    KnownOutcomeRuns = sumif(ItemCount, isnotnull(Success)),\n    FailedRuns = sumif(ItemCount, Success == false),\n    P95_ms = percentile(DurationMs, 95)\n| project ObservedRuns = iff(Runs > 0, Runs, long(null)),\n    FailureRatePercent = iff(\n        KnownOutcomeRuns > 0,\n        100.0 * todouble(FailedRuns) / todouble(KnownOutcomeRuns),\n        real(null)\n    ),\n    P95_ms\n",
            "resultFormat": "table",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
