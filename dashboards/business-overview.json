{
  "uid": "azure-ai-business-overview",
  "title": "Azure AI - Business overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "azure",
    "ai-observability"
  ],
  "timezone": "utc",
  "refresh": "1h",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Observed agent runs per interval",
      "type": "timeseries",
      "description": "Each point is a time-bucket count, not the total for the selected range. Counts are weighted for sampling when present. No data is not evidence of zero activity or healthy service.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "union AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where tostring(Properties[\"gen_ai.operation.name\"]) == \"invoke_agent\"\n| extend Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| summarize ObservedRuns = sum(ItemCount)\n    by bin(TimeGenerated, $__interval), Agent\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*ObservedRuns.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "title": "PTU utilization - average",
      "type": "timeseries",
      "description": "Azure platform metric for the configured provisioned deployment. Availability depends on the model and SKU.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$ptuSubscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$ptuSubscription",
                "resourceGroup": "$ptuResourceGroup",
                "resourceName": "$ptuAccount",
                "region": "$ptuRegion",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "AzureOpenAIProvisionedManagedUtilizationV2",
            "aggregation": "Average",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$ptuDeployment"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "Agent run latency",
      "type": "timeseries",
      "description": "Percentiles reflect retained, instrumented spans and are not an end-to-end service-level objective.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "union AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where tostring(Properties[\"gen_ai.operation.name\"]) == \"invoke_agent\"\n| extend Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| summarize P50_ms = percentile(DurationMs, 50),\n    P95_ms = percentile(DurationMs, 95),\n    P99_ms = percentile(DurationMs, 99)\n    by bin(TimeGenerated, $__interval), Agent\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "PTU requests by status code",
      "type": "timeseries",
      "description": "Azure platform request counts by status for the configured deployment. Counts are per time bucket, not per second.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$ptuSubscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$ptuSubscription",
                "resourceGroup": "$ptuResourceGroup",
                "resourceName": "$ptuAccount",
                "region": "$ptuRegion",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "AzureOpenAIRequests",
            "aggregation": "Total",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$ptuDeployment"
                ]
              },
              {
                "dimension": "StatusCode",
                "operator": "eq",
                "filters": [
                  "*"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Throttled requests (429)",
      "type": "timeseries",
      "description": "Azure platform 429 request counts per time bucket, not a rate. No data can mean no matching traffic or unavailable metrics.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$ptuSubscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$ptuSubscription",
                "resourceGroup": "$ptuResourceGroup",
                "resourceName": "$ptuAccount",
                "region": "$ptuRegion",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "AzureOpenAIRequests",
            "aggregation": "Total",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$ptuDeployment"
                ]
              },
              {
                "dimension": "StatusCode",
                "operator": "eq",
                "filters": [
                  "429"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*429.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "Agent run failure rate",
      "type": "timeseries",
      "description": "Failed runs divided by runs with a known success/failure outcome, weighted by ItemCount where sampling is present. No data is not a zero failure rate; retained spans may be sampled.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "union AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where tostring(Properties[\"gen_ai.operation.name\"]) == \"invoke_agent\"\n| where isnotnull(Success)\n| extend Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| summarize KnownOutcomeRuns = sum(ItemCount),\n    FailedRuns = sumif(ItemCount, Success == false)\n    by bin(TimeGenerated, $__interval), Agent\n| extend FailureRatePercent = iff(\n    KnownOutcomeRuns > 0,\n    100.0 * todouble(FailedRuns) / todouble(KnownOutcomeRuns),\n    real(null)\n)\n| project TimeGenerated, FailureRatePercent, Agent\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*FailureRatePercent.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "PTU input and output tokens",
      "type": "timeseries",
      "description": "Azure platform token counts per time bucket for the configured deployment.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$ptuSubscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$ptuSubscription",
                "resourceGroup": "$ptuResourceGroup",
                "resourceName": "$ptuAccount",
                "region": "$ptuRegion",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "ProcessedPromptTokens",
            "aggregation": "Total",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$ptuDeployment"
                ]
              }
            ]
          }
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$ptuSubscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$ptuSubscription",
                "resourceGroup": "$ptuResourceGroup",
                "resourceName": "$ptuAccount",
                "region": "$ptuRegion",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "GeneratedTokens",
            "aggregation": "Total",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$ptuDeployment"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "workspaceResourceId",
        "label": "Agent telemetry workspace ARM ID",
        "type": "textbox",
        "query": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/monitoring-rg/providers/Microsoft.OperationalInsights/workspaces/replace-me",
        "current": {
          "text": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/monitoring-rg/providers/Microsoft.OperationalInsights/workspaces/replace-me",
          "value": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/monitoring-rg/providers/Microsoft.OperationalInsights/workspaces/replace-me"
        },
        "hide": 0
      },
      {
        "name": "ptuSubscription",
        "label": "ptuSubscription",
        "type": "textbox",
        "query": "00000000-0000-0000-0000-000000000000",
        "current": {
          "text": "00000000-0000-0000-0000-000000000000",
          "value": "00000000-0000-0000-0000-000000000000"
        },
        "hide": 0
      },
      {
        "name": "ptuResourceGroup",
        "label": "ptuResourceGroup",
        "type": "textbox",
        "query": "existing-openai-rg",
        "current": {
          "text": "existing-openai-rg",
          "value": "existing-openai-rg"
        },
        "hide": 0
      },
      {
        "name": "ptuAccount",
        "label": "ptuAccount",
        "type": "textbox",
        "query": "existing-openai-account",
        "current": {
          "text": "existing-openai-account",
          "value": "existing-openai-account"
        },
        "hide": 0
      },
      {
        "name": "ptuRegion",
        "label": "ptuRegion",
        "type": "textbox",
        "query": "eastus",
        "current": {
          "text": "eastus",
          "value": "eastus"
        },
        "hide": 0
      },
      {
        "name": "ptuDeployment",
        "label": "ptuDeployment",
        "type": "textbox",
        "query": "replace-with-provisioned-deployment-name",
        "current": {
          "text": "replace-with-provisioned-deployment-name",
          "value": "replace-with-provisioned-deployment-name"
        },
        "hide": 0
      }
    ]
  },
  "__inputs": [
    {
      "name": "DS_AZURE_MONITOR",
      "label": "Azure Monitor",
      "type": "datasource",
      "pluginId": "grafana-azure-monitor-datasource",
      "pluginName": "Azure Monitor"
    }
  ],
  "links": [
    {
      "type": "link",
      "title": "Agent operations",
      "url": "/d/foundry-agent-operations/_?var-workspaceResourceId=${workspaceResourceId:percentencode}",
      "icon": "external link alt",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "type": "link",
      "title": "PTU performance",
      "url": "/d/azure-openai-ptu/_?var-subscription=${ptuSubscription:percentencode}&var-resourceGroup=${ptuResourceGroup:percentencode}&var-account=${ptuAccount:percentencode}&var-region=${ptuRegion:percentencode}&var-deployment=${ptuDeployment:percentencode}",
      "icon": "external link alt",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "description": "A concise view of observed agent activity and Azure OpenAI PTU signals. It does not calculate a blended health score and shows no cost; use Azure Cost Management or the optional cost dashboard for billed cost. No data can indicate no traffic, missing permissions, unsupported metrics, or absent instrumentation. Agent telemetry requires application instrumentation."
}
