{
  "uid": "azure-ai-business-overview",
  "title": "Azure AI - Business overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "azure",
    "ai-observability"
  ],
  "timezone": "utc",
  "refresh": "1h",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Cost collection status",
      "type": "table",
      "description": "Shows whether a complete snapshot is current and covers the selected period. Missing or stale collection is not zero cost.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$monitoringWorkspaceResourceId"
            ],
            "query": "// Shared prefix: choose only the newest fully ingested snapshot.\nlet SnapshotRecords = materialize(\n    AICostSnapshot_CL\n    | where TimeGenerated >= ago(14d)\n    | where RecordType in (\"Cost\", \"Complete\")\n);\nlet CostRows = materialize(\n    SnapshotRecords\n    | where RecordType == \"Cost\" and isnotempty(RunId) and isnotempty(RowKey)\n    | summarize arg_max(TimeGenerated, *) by RunId, RowKey\n);\nlet RowCounts = CostRows | summarize IngestedRows = count() by RunId;\nlet LatestCompleteSnapshot = materialize(\n    SnapshotRecords\n    | where RecordType == \"Complete\" and isnotempty(RunId)\n    | summarize arg_max(TimeGenerated, *) by RunId\n    | join kind=leftouter RowCounts on RunId\n    | extend IngestedRows = coalesce(IngestedRows, long(0))\n    | where ExpectedRows == IngestedRows\n    | project RunId, SnapshotTime = TimeGenerated, ExpectedRows, WindowStart, WindowEnd\n    | top 1 by SnapshotTime desc\n);\nlet LatestCostRows = CostRows\n    | where RunId in (LatestCompleteSnapshot | project RunId);\n\nprint JoinKey = 1\n| join kind=leftouter (LatestCompleteSnapshot | extend JoinKey = 1) on JoinKey\n| extend Status = case(\n    isempty(RunId), \"Missing snapshot\",\n    SnapshotTime < ago(48h), \"Stale - check logs\",\n    ExpectedRows == 0, \"No cost data\",\n    \"Current\"\n)\n| extend Coverage = case(\n    isempty(RunId), \"No collection\",\n    startofday($__timeFrom()) < WindowStart, \"Before history\",\n    startofday($__timeTo()) > startofday(WindowEnd), \"After history\",\n    \"Within history\"\n)\n| project Status, Coverage, LastCollectedUTC = SnapshotTime, HistoryFromUTC = WindowStart, HistoryThroughUTC = WindowEnd, ReportedRows = ExpectedRows\n",
            "resultFormat": "table",
            "timeColumn": "TimeGenerated",
            "dashboardTime": false
          }
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "LastCollectedUTC": true,
              "HistoryFromUTC": true,
              "HistoryThroughUTC": true,
              "ReportedRows": true
            },
            "indexByName": {
              "Status": 0,
              "Coverage": 1
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Actual cost by currency",
      "type": "table",
      "description": "Pretax account-attributed actual cost for the selected UTC period. Currencies remain separate; use the cost dashboard for amortized cost.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$monitoringWorkspaceResourceId"
            ],
            "query": "// Shared prefix: choose only the newest fully ingested snapshot.\nlet SnapshotRecords = materialize(\n    AICostSnapshot_CL\n    | where TimeGenerated >= ago(14d)\n    | where RecordType in (\"Cost\", \"Complete\")\n);\nlet CostRows = materialize(\n    SnapshotRecords\n    | where RecordType == \"Cost\" and isnotempty(RunId) and isnotempty(RowKey)\n    | summarize arg_max(TimeGenerated, *) by RunId, RowKey\n);\nlet RowCounts = CostRows | summarize IngestedRows = count() by RunId;\nlet LatestCompleteSnapshot = materialize(\n    SnapshotRecords\n    | where RecordType == \"Complete\" and isnotempty(RunId)\n    | summarize arg_max(TimeGenerated, *) by RunId\n    | join kind=leftouter RowCounts on RunId\n    | extend IngestedRows = coalesce(IngestedRows, long(0))\n    | where ExpectedRows == IngestedRows\n    | project RunId, SnapshotTime = TimeGenerated, ExpectedRows, WindowStart, WindowEnd\n    | top 1 by SnapshotTime desc\n);\nlet LatestCostRows = CostRows\n    | where RunId in (LatestCompleteSnapshot | project RunId);\n\nLatestCostRows\n| where CostType == \"ActualCost\"\n| where UsageDate >= startofday($__timeFrom()) and UsageDate < $__timeTo()\n| summarize Amount = sum(Cost) by Currency\n| order by Currency asc\n",
            "resultFormat": "table",
            "timeColumn": "TimeGenerated",
            "dashboardTime": false
          }
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "title": "Observed agent runs and failures",
      "type": "timeseries",
      "description": "Application Insights counts, weighted for sampling when present. No telemetry is not evidence of zero activity or healthy service. Counts are not a coverage percentage.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "union AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| where tostring(Properties[\"gen_ai.operation.name\"]) == \"invoke_agent\"\n| extend Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| summarize ObservedRuns = sum(ItemCount),\n    FailedRuns = sumif(ItemCount, Success == false)\n    by bin(TimeGenerated, $__interval), Agent\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*ObservedRuns.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*FailedRuns.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "PTU utilization - average",
      "type": "timeseries",
      "description": "Azure platform metric for the configured provisioned deployment. Availability depends on the model and SKU.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$ptuSubscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$ptuSubscription",
                "resourceGroup": "$ptuResourceGroup",
                "resourceName": "$ptuAccount",
                "region": "$ptuRegion",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "AzureOpenAIProvisionedManagedUtilizationV2",
            "aggregation": "Average",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$ptuDeployment"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
