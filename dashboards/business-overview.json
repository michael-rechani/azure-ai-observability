        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$monitoringWorkspaceResourceId"
            ],
            "query": "// Shared prefix: choose only the newest fully ingested snapshot.\nlet SnapshotRecords = materialize(\n    AICostSnapshot_CL\n    | where TimeGenerated >= ago(14d)\n    | where RecordType in (\"Cost\", \"Complete\")\n);\nlet CostRows = materialize(\n    SnapshotRecords\n    | where RecordType == \"Cost\" and isnotempty(RunId) and isnotempty(RowKey)\n    | summarize arg_max(TimeGenerated, *) by RunId, RowKey\n);\nlet RowCounts = CostRows | summarize IngestedRows = count() by RunId;\nlet LatestCompleteSnapshot = materialize(\n    SnapshotRecords\n    | where RecordType == \"Complete\" and isnotempty(RunId)\n    | summarize arg_max(TimeGenerated, *) by RunId\n    | join kind=leftouter RowCounts on RunId\n    | extend IngestedRows = coalesce(IngestedRows, long(0))\n    | where ExpectedRows == IngestedRows\n    | project RunId, SnapshotTime = TimeGenerated, ExpectedRows, WindowStart, WindowEnd\n    | top 1 by SnapshotTime desc\n);\nlet LatestCostRows = CostRows\n    | where RunId in (LatestCompleteSnapshot | project RunId);\n\nLatestCostRows\n| where CostType == \"ActualCost\"\n| where UsageDate >= startofday($__timeFrom()) and UsageDate < $__timeTo()\n| summarize Amount = sum(Cost) by UsageDate, Currency\n| project TimeGenerated = UsageDate, Currency, Amount\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": false
