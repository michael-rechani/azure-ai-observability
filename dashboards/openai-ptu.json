              {
                "subscription": "$subscription",
                "resourceGroup": "$resourceGroup",
                "resourceName": "$account",
                "region": "$region",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "AzureOpenAIRequests",
            "aggregation": "Total",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$deployment"
                ]
              },
              {
                "dimension": "StatusCode",
                "operator": "eq",
                "filters": [
                  "*"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*200.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*429.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
