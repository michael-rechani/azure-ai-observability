{
  "uid": "azure-openai-ptu",
  "title": "Azure OpenAI - PTU performance",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "azure",
    "ai-observability"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "PTU utilization - average",
      "type": "timeseries",
      "description": "Azure platform metric. Availability varies by model/SKU. Counts are per time bucket, not per second.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$subscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$subscription",
                "resourceGroup": "$resourceGroup",
                "resourceName": "$account",
                "region": "$region",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "AzureOpenAIProvisionedManagedUtilizationV2",
            "aggregation": "Average",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$deployment"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
