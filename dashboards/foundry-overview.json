{
  "uid": "foundry-overview",
  "title": "Foundry - Resource and model overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "azure",
    "ai-observability"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Accessible Foundry / OpenAI / ML resources",
      "type": "table",
      "description": "Inventory is RBAC-filtered and includes ML workspaces; not every row is a Foundry hub.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Resource Graph",
          "subscriptions": [
            "$subscription"
          ],
          "azureResourceGraph": {
            "query": "Resources\n| where type in~ (\n    \"microsoft.cognitiveservices/accounts\",\n    \"microsoft.cognitiveservices/accounts/projects\",\n    \"microsoft.machinelearningservices/workspaces\")\n| project name, type, kind, subscriptionId, resourceGroup, location, id\n| order by type asc, name asc\n",
            "resultFormat": "table",
            "scope": "subscription"
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Observed agent telemetry",
      "type": "timeseries",
      "description": "Counts of observed and recognized spans, not a coverage percentage. A completely silent workspace cannot establish telemetry health.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Log Analytics",
          "azureLogAnalytics": {
            "resources": [
              "$workspaceResourceId"
            ],
            "query": "union AppRequests, AppDependencies\n| where $__timeFilter(TimeGenerated)\n| extend Operation = tostring(Properties[\"gen_ai.operation.name\"]),\n    Agent = tostring(Properties[\"gen_ai.agent.name\"])\n| summarize ObservedSpans = sum(ItemCount),\n    GenAISpans = sumif(ItemCount, isnotempty(Operation)),\n    AgentRuns = sumif(ItemCount, Operation == \"invoke_agent\"),\n    UnnamedAgentRuns = sumif(ItemCount, Operation == \"invoke_agent\" and isempty(Agent))\n    by bin(TimeGenerated, $__interval)\n| order by TimeGenerated asc\n",
            "resultFormat": "time_series",
            "timeColumn": "TimeGenerated",
            "dashboardTime": true
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "title": "OpenAI requests by deployment and status",
      "type": "timeseries",
      "description": "OpenAI-specific metric on the selected account; not a universal metric for every Foundry model.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$subscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$subscription",
                "resourceGroup": "$resourceGroup",
                "resourceName": "$account",
                "region": "$region",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "AzureOpenAIRequests",
            "aggregation": "Total",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$deployment"
                ]
              },
              {
                "dimension": "StatusCode",
                "operator": "eq",
                "filters": [
                  "*"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "OpenAI inference tokens per interval",
      "type": "timeseries",
      "description": "OpenAI-specific metric on the selected account; not a universal metric for every Foundry model.",
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "${DS_AZURE_MONITOR}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${DS_AZURE_MONITOR}"
          },
          "queryType": "Azure Monitor",
          "subscription": "$subscription",
          "azureMonitor": {
            "resources": [
              {
                "subscription": "$subscription",
                "resourceGroup": "$resourceGroup",
                "resourceName": "$account",
                "region": "$region",
                "metricNamespace": "Microsoft.CognitiveServices/accounts"
              }
            ],
            "metricNamespace": "Microsoft.CognitiveServices/accounts",
            "metricName": "TokenTransaction",
            "aggregation": "Total",
            "timeGrain": "auto",
            "top": "100",
            "dimensionFilters": [
              {
                "dimension": "ModelDeploymentName",
                "operator": "eq",
                "filters": [
                  "$deployment"
                ]
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "subscription",
        "label": "subscription",
        "type": "textbox",
        "query": "00000000-0000-0000-0000-000000000000",
        "current": {
          "text": "00000000-0000-0000-0000-000000000000",
          "value": "00000000-0000-0000-0000-000000000000"
        },
        "hide": 0
      },
      {
        "name": "workspaceResourceId",
        "label": "Telemetry workspace ARM ID",
        "type": "textbox",
        "query": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/monitoring-rg/providers/Microsoft.OperationalInsights/workspaces/replace-me",
        "current": {
          "text": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/monitoring-rg/providers/Microsoft.OperationalInsights/workspaces/replace-me",
          "value": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/monitoring-rg/providers/Microsoft.OperationalInsights/workspaces/replace-me"
        },
        "hide": 0
      },
      {
        "name": "resourceGroup",
        "label": "resourceGroup",
        "type": "textbox",
        "query": "existing-foundry-rg",
        "current": {
          "text": "existing-foundry-rg",
          "value": "existing-foundry-rg"
        },
        "hide": 0
      },
      {
        "name": "account",
        "label": "account",
        "type": "textbox",
        "query": "existing-foundry-account",
        "current": {
          "text": "existing-foundry-account",
          "value": "existing-foundry-account"
        },
        "hide": 0
      },
      {
        "name": "region",
        "label": "region",
        "type": "textbox",
        "query": "eastus",
        "current": {
          "text": "eastus",
          "value": "eastus"
        },
        "hide": 0
      },
      {
        "name": "deployment",
        "label": "OpenAI deployment (or *)",
        "type": "textbox",
        "query": "*",
        "current": {
          "text": "*",
          "value": "*"
        },
        "hide": 0
      }
    ]
  },
  "__inputs": [
    {
      "name": "DS_AZURE_MONITOR",
      "label": "Azure Monitor",
      "type": "datasource",
      "pluginId": "grafana-azure-monitor-datasource",
      "pluginName": "Azure Monitor"
    }
  ]
}
