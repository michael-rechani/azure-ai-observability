    },
    {
      "type": "link",
      "title": "Business overview",
      "url": "/d/azure-ai-business-overview/_?var-workspaceResourceId=${workspaceResourceId:percentencode}&var-ptuSubscription=${subscription:percentencode}",
      "icon": "external link alt",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ]
}
