{
  "uid": "azure-ai-costs-infinity",
  "title": "Azure AI - Cost visibility (direct Cost Management query)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "azure",
    "ai-observability"
  ],
  "timezone": "utc",
  "refresh": "1h",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Month-to-date actual cost by currency",
      "type": "table",
      "description": "Actual cost of Foundry and Azure OpenAI accounts since the start of the UTC month, read from the Cost Management Query API. Billing can be revised or delayed.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_COST_INFINITY}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_COST_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "jq-backend",
          "url": "https://management.azure.com${costScope}/providers/Microsoft.CostManagement/query?api-version=2023-11-01",
          "root_selector": "if .properties.nextLink then error(\"incomplete_cost_response\") else .properties as $p | ($p.columns | map(.name)) as $c | [$p.rows[] | . as $r | reduce range(0; ($c | length)) as $i ({}; .[$c[$i]] = $r[$i])] end",
          "columns": [
            {
              "selector": "PreTaxCost",
              "text": "Cost",
              "type": "number"
            },
            {
              "selector": "Currency",
              "text": "Currency",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"type\":\"ActualCost\",\"timeframe\":\"MonthToDate\",\"dataset\":{\"granularity\":\"None\",\"aggregation\":{\"totalCost\":{\"name\":\"PreTaxCost\",\"function\":\"Sum\"}},\"filter\":{\"dimensions\":{\"name\":\"ResourceType\",\"operator\":\"In\",\"values\":[\"microsoft.cognitiveservices/accounts\"]}}}}",
            "headers": [
              {
                "key": "ClientType",
                "value": "AzureAiObservability"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Daily actual cost",
      "type": "timeseries",
      "description": "Daily actual cost per billing currency for the selected period. The Query API allows at most 31 days of daily data, so a longer dashboard range fails instead of being truncated.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_COST_INFINITY}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_COST_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "jq-backend",
          "url": "https://management.azure.com${costScope}/providers/Microsoft.CostManagement/query?api-version=2023-11-01",
          "root_selector": "if .properties.nextLink then error(\"incomplete_cost_response\") else .properties as $p | ($p.columns | map(.name)) as $c | [$p.rows[] | . as $r | reduce range(0; ($c | length)) as $i ({}; .[$c[$i]] = $r[$i])] end | map(if has(\"UsageDate\") then .UsageDate = ((.UsageDate | tostring) as $d | $d[0:4] + \"-\" + $d[4:6] + \"-\" + $d[6:8]) else . end)",
          "columns": [
            {
              "selector": "UsageDate",
              "text": "Date",
              "type": "timestamp"
            },
            {
              "selector": "PreTaxCost",
              "text": "Cost",
              "type": "number"
            },
            {
              "selector": "Currency",
              "text": "Currency",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"type\":\"ActualCost\",\"timeframe\":\"Custom\",\"timePeriod\":{\"from\":\"${__from:date:iso}\",\"to\":\"${__to:date:iso}\"},\"dataset\":{\"granularity\":\"Daily\",\"aggregation\":{\"totalCost\":{\"name\":\"PreTaxCost\",\"function\":\"Sum\"}},\"filter\":{\"dimensions\":{\"name\":\"ResourceType\",\"operator\":\"In\",\"values\":[\"microsoft.cognitiveservices/accounts\"]}}}}",
            "headers": [
              {
                "key": "ClientType",
                "value": "AzureAiObservability"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "Currency"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": false
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Cost by account",
      "type": "table",
      "description": "Actual cost by Foundry or Azure OpenAI account for the selected period.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_COST_INFINITY}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_COST_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "jq-backend",
          "url": "https://management.azure.com${costScope}/providers/Microsoft.CostManagement/query?api-version=2023-11-01",
          "root_selector": "if .properties.nextLink then error(\"incomplete_cost_response\") else .properties as $p | ($p.columns | map(.name)) as $c | [$p.rows[] | . as $r | reduce range(0; ($c | length)) as $i ({}; .[$c[$i]] = $r[$i])] end | map(.Account = (.ResourceId | split(\"/\") | .[-1]) | .ResourceGroup = (.ResourceId | split(\"/\") | .[4]))",
          "columns": [
            {
              "selector": "Account",
              "text": "Account",
              "type": "string"
            },
            {
              "selector": "ResourceGroup",
              "text": "Resource group",
              "type": "string"
            },
            {
              "selector": "PreTaxCost",
              "text": "Cost",
              "type": "number"
            },
            {
              "selector": "Currency",
              "text": "Currency",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"type\":\"ActualCost\",\"timeframe\":\"Custom\",\"timePeriod\":{\"from\":\"${__from:date:iso}\",\"to\":\"${__to:date:iso}\"},\"dataset\":{\"granularity\":\"None\",\"aggregation\":{\"totalCost\":{\"name\":\"PreTaxCost\",\"function\":\"Sum\"}},\"filter\":{\"dimensions\":{\"name\":\"ResourceType\",\"operator\":\"In\",\"values\":[\"microsoft.cognitiveservices/accounts\"]}},\"grouping\":[{\"type\":\"Dimension\",\"name\":\"ResourceId\"}]}}",
            "headers": [
              {
                "key": "ClientType",
                "value": "AzureAiObservability"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "title": "Cost by meter",
      "type": "table",
      "description": "Actual cost and quantity by meter, which separates input, output and provisioned charges.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_COST_INFINITY}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_COST_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "jq-backend",
          "url": "https://management.azure.com${costScope}/providers/Microsoft.CostManagement/query?api-version=2023-11-01",
          "root_selector": "if .properties.nextLink then error(\"incomplete_cost_response\") else .properties as $p | ($p.columns | map(.name)) as $c | [$p.rows[] | . as $r | reduce range(0; ($c | length)) as $i ({}; .[$c[$i]] = $r[$i])] end",
          "columns": [
            {
              "selector": "Meter",
              "text": "Meter",
              "type": "string"
            },
            {
              "selector": "UsageQuantity",
              "text": "Quantity",
              "type": "number"
            },
            {
              "selector": "PreTaxCost",
              "text": "Cost",
              "type": "number"
            },
            {
              "selector": "Currency",
              "text": "Currency",
              "type": "string"
            }
          ],
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"type\":\"ActualCost\",\"timeframe\":\"Custom\",\"timePeriod\":{\"from\":\"${__from:date:iso}\",\"to\":\"${__to:date:iso}\"},\"dataset\":{\"granularity\":\"None\",\"aggregation\":{\"totalCost\":{\"name\":\"PreTaxCost\",\"function\":\"Sum\"},\"totalQuantity\":{\"name\":\"UsageQuantity\",\"function\":\"Sum\"}},\"filter\":{\"dimensions\":{\"name\":\"ResourceType\",\"operator\":\"In\",\"values\":[\"microsoft.cognitiveservices/accounts\"]}},\"grouping\":[{\"type\":\"Dimension\",\"name\":\"Meter\"}]}}",
            "headers": [
              {
                "key": "ClientType",
                "value": "AzureAiObservability"
              }
            ]
          }
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "costScope",
        "label": "Cost query scope",
        "type": "textbox",
        "query": "/subscriptions/00000000-0000-0000-0000-000000000000",
        "current": {
          "text": "/subscriptions/00000000-0000-0000-0000-000000000000",
          "value": "/subscriptions/00000000-0000-0000-0000-000000000000"
        },
        "hide": 0
      }
    ]
  },
  "__inputs": [
    {
      "name": "DS_COST_INFINITY",
      "label": "Cost Management (Infinity)",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "description": "Actual cost of Azure AI resources queried directly from the Cost Management Query API through the Infinity data source, with no export, storage or cluster. The data source uses a service principal client secret that you must rotate, and every user who can edit its queries inherits that principal's cost access. No data can mean billing has not caught up, not zero cost."
}
