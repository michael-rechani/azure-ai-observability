// Azure Data Explorer database script for the native cost path.
// Placeholders {{CURRENT_URL}} and {{CLOSED_URL}} are replaced by the Bicep and Terraform deployments.
// Cost Management also writes a manifest.json beside each CSV; fileExtension keeps it out of the CSV read.
// Cost Management CSV columns map by position, so the schema is the leading prefix of the export
// (through costInUsd). Columns appended later by Cost Management are ignored.

.alter-merge database costs policy managed_identity ```[{"ObjectId":"system","AllowedUsages":"ExternalTable"}]```

.create-or-alter external table CostExportCurrent (
  InvoiceId:string, PreviousInvoiceId:string, BillingAccountId:string, BillingAccountName:string,
  BillingProfileId:string, BillingProfileName:string, InvoiceSectionId:string, InvoiceSectionName:string,
  ResellerName:string, ResellerMpnId:string, CostCenter:string,
  BillingPeriodEndDate:string, BillingPeriodStartDate:string, ServicePeriodEndDate:string, ServicePeriodStartDate:string,
  ChargeDate:string, ServiceFamily:string, ProductOrderId:string, ProductOrderName:string, ConsumedService:string,
  MeterId:string, MeterName:string, MeterCategory:string, MeterSubCategory:string, MeterRegion:string,
  ProductId:string, ProductName:string, SubscriptionId:string, SubscriptionName:string,
  PublisherType:string, PublisherId:string, PublisherName:string, ResourceGroupName:string, ResourceId:string,
  ResourceLocation:string, Location:string, EffectivePrice:real, Quantity:real, UnitOfMeasure:string,
  ChargeType:string, BillingCurrency:string, PricingCurrency:string,
  CostInBillingCurrency:real, CostInPricingCurrency:real, CostInUsd:real
)
kind=storage
dataformat=csv
(
  h@'{{CURRENT_URL}};managed_identity=system'
)
with (includeHeaders='All', fileExtension='.csv')

.create-or-alter external table CostExportClosed (
  InvoiceId:string, PreviousInvoiceId:string, BillingAccountId:string, BillingAccountName:string,
  BillingProfileId:string, BillingProfileName:string, InvoiceSectionId:string, InvoiceSectionName:string,
  ResellerName:string, ResellerMpnId:string, CostCenter:string,
  BillingPeriodEndDate:string, BillingPeriodStartDate:string, ServicePeriodEndDate:string, ServicePeriodStartDate:string,
  ChargeDate:string, ServiceFamily:string, ProductOrderId:string, ProductOrderName:string, ConsumedService:string,
  MeterId:string, MeterName:string, MeterCategory:string, MeterSubCategory:string, MeterRegion:string,
  ProductId:string, ProductName:string, SubscriptionId:string, SubscriptionName:string,
  PublisherType:string, PublisherId:string, PublisherName:string, ResourceGroupName:string, ResourceId:string,
  ResourceLocation:string, Location:string, EffectivePrice:real, Quantity:real, UnitOfMeasure:string,
  ChargeType:string, BillingCurrency:string, PricingCurrency:string,
  CostInBillingCurrency:real, CostInPricingCurrency:real, CostInUsd:real
)
kind=storage
dataformat=csv
(
  h@'{{CLOSED_URL}};managed_identity=system'
)
with (includeHeaders='All', fileExtension='.csv')

.create-or-alter function with (folder='cost', docstring='Actual cost of Azure AI (Cognitive Services, Foundry, OpenAI) resources. Closed months come from the monthly last-month export; the current month comes from the daily month-to-date export.')
AiCost() {
  let Shape = (T:(ChargeDate:string, ResourceId:string, SubscriptionId:string, SubscriptionName:string,
                  ResourceGroupName:string, MeterCategory:string, MeterSubCategory:string, MeterName:string,
                  ProductName:string, ChargeType:string, Quantity:real, UnitOfMeasure:string,
                  BillingCurrency:string, CostInBillingCurrency:real, CostInUsd:real)) {
    T
    | where ResourceId has '/providers/microsoft.cognitiveservices/'
    | extend Date = todatetime(ChargeDate)
    | project Date, SubscriptionId, SubscriptionName, ResourceGroupName, ResourceId, MeterCategory, MeterSubCategory,
              MeterName, ProductName, ChargeType, Quantity, UnitOfMeasure, BillingCurrency,
              Cost = CostInBillingCurrency, CostUsd = CostInUsd
  };
  let Closed = Shape(external_table('CostExportClosed'));
  let ClosedMonths = Closed | summarize by Month = startofmonth(Date);
  let Current = Shape(external_table('CostExportCurrent'))
    | extend Month = startofmonth(Date)
    | join kind=leftanti ClosedMonths on Month
    | project-away Month;
  union Closed, Current
}
