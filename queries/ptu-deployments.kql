Resources
| where type =~ "microsoft.cognitiveservices/accounts/deployments"
| where subscriptionId =~ "$subscription"
| where resourceGroup =~ "$resourceGroup"
| where name startswith strcat("$account", "/")
| extend Segments = split(name, "/")
| extend Deployment = tostring(Segments[array_length(Segments) - 1])
| extend Model = tostring(properties.model.name),
    ModelVersion = tostring(properties.model.version),
    ScaleType = tostring(properties.scaleSettings.scaleType),
    AllocatedPTUs = tolong(sku.capacity)
| where sku.name =~ "ProvisionedManaged" or ScaleType =~ "ProvisionedManaged"
| project Deployment, Model, ModelVersion, ScaleType,
    AllocatedPTUs, Region = location
| order by Deployment asc
