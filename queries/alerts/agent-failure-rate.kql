AppRequests
| where TimeGenerated > ago(10m)
| where tostring(Properties["gen_ai.operation.name"]) == "invoke_agent"
| extend Agent = iff(isempty(tostring(Properties["gen_ai.agent.name"])),
    "unnamed", tostring(Properties["gen_ai.agent.name"]))
| summarize ObservedRuns = sum(ItemCount),
    FailedRuns = sumif(ItemCount, Success == false) by Agent
| where ObservedRuns >= ${minimum_agent_runs}
| extend FailureRatePercent = 100.0 * todouble(FailedRuns) / todouble(ObservedRuns)
| project Agent, FailureRatePercent
