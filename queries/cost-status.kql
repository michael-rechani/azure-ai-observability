print JoinKey = 1
| join kind=leftouter (LatestCompleteSnapshot | extend JoinKey = 1) on JoinKey
| extend Status = case(
    isempty(RunId), "Missing snapshot",
    SnapshotTime < ago(48h), "Stale - check logs",
    ExpectedRows == 0, "No cost data",
    "Current"
)
| extend Coverage = case(
    isempty(RunId), "No collection",
    startofday($__timeFrom()) < WindowStart, "Before history",
    startofday($__timeTo()) > startofday(WindowEnd), "After history",
    "Within history"
)
| project Status, Coverage, LastCollectedUTC = SnapshotTime, HistoryFromUTC = WindowStart, HistoryThroughUTC = WindowEnd, ReportedRows = ExpectedRows
