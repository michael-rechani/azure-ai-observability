    {
      "id": 1,
      "type": "text",
      "title": "Understand these costs",
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "ai-demo-data"
      },
      "targets": [],
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Pretax account costs, not invoice or deployment totals.** Actual and amortized are alternatives: **do not add them together**. Billing can lag; missing data is not zero. Currencies stay separate. Partial UTC days include the full reported day."
      }
    },
    {
      "id": 2,
      "title": "Collection status and selected-period coverage",
      "type": "table",
      "description": "The latest fully ingested snapshot from the last 14 days. Stale means the collection is over 48 hours old. A range outside collected history can be incomplete.",
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "ai-demo-data"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "ai-demo-data"
          },
          "refId": "A",
          "scenarioId": "csv_content",
          "csvContent": "Status,Coverage,LastCollectedUTC,HistoryFromUTC,HistoryThroughUTC,ReportedRows\nCurrent,Within history,2026-10-31 06:00,2026-08-03,2026-10-31,360\n"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data reported"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
