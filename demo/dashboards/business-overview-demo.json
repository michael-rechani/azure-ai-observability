    {
      "id": 1,
      "title": "Cost collection status",
      "type": "table",
      "description": "Shows whether a complete snapshot is current and covers the selected period. Missing or stale collection is not zero cost.",
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "ai-demo-data"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "ai-demo-data"
          },
          "refId": "A",
          "scenarioId": "csv_content",
          "csvContent": "Status,Coverage,LastCollectedUTC,HistoryFromUTC,HistoryThroughUTC,ReportedRows\nCurrent,Within history,2026-10-31 06:00,2026-08-03,2026-10-31,360\n"
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "LastCollectedUTC": true,
              "HistoryFromUTC": true,
              "HistoryThroughUTC": true,
              "ReportedRows": true
            },
            "indexByName": {
              "Status": 0,
              "Coverage": 1
            }
          }
        }
      ]
    },
