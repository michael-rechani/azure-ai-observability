            "uid": "ai-demo-data"
          },
          "refId": "B",
          "scenarioId": "csv_metric_values",
          "alias": "FailedRuns",
          "stringInput": "8,10,9,11,12,10,13,15,19,14,16,18,15,14,17,15,12,13,14,12"
        }
