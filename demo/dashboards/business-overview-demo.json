    {
      "id": 8,
      "title": "Agent summary - selected period",
      "type": "stat",
      "description": "Whole-period figures over retained invoke_agent spans for the selected agent. Runs are weighted by ItemCount, the failure rate uses runs with a known outcome, and p95 is taken over retained spans without sampling weights. No data is not evidence of health: the agent may be idle, sampled out or uninstrumented. Threshold colours mirror the default alerts.",
      "datasource": {
        "type": "grafana-testdata-datasource",
        "uid": "ai-demo-data"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "ai-demo-data"
          },
          "refId": "A",
          "scenarioId": "csv_content",
          "csvContent": "ObservedRuns,FailureRatePercent,P95_ms\n25920,1.03,1260\n"
