        "type": "grafana-testdata-datasource",
        "uid": "ai-demo-data"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-testdata-datasource",
            "uid": "ai-demo-data"
          },
          "refId": "A",
          "scenarioId": "csv_metric_values",
          "alias": "ObservedRuns",
          "stringInput": "1100,1150,1130,1200,1250,1230,1280,1320,1400,1350,1380,1420,1360,1340,1390,1350,1300,1320,1340,1310"
        },
