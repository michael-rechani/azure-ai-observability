grafana_endpoint         = "https://replace-with-grafana-endpoint.example.invalid"
subscription_id          = "00000000-0000-0000-0000-000000000000"
# Business overview dashboard (agent and PTU signals); it reads the telemetry workspace set in dashboard_defaults below.
enable_business_overview = false

# Opt-in direct Cost Management queries through Infinity. NOT secretless: the service principal client secret
# is stored in Grafana and in this stage's Terraform state. Set enable_cost_infinity in the Azure stage first and
# use its cost_infinity_* outputs. Supply the secret as TF_VAR_cost_infinity_client_secret, never in a tfvars file.
enable_cost_infinity_dashboard = false
# cost_infinity_tenant_id = "00000000-0000-0000-0000-000000000000"
# cost_infinity_client_id = "00000000-0000-0000-0000-000000000000"
# cost_infinity_scope     = "/subscriptions/00000000-0000-0000-0000-000000000000"
# Alert when the data source can no longer query Cost Management (for example the secret expired). On by default
# with the Infinity dashboard. It still needs a contact point that routes component=cost-infinity; see docs/costs.md.
# enable_cost_infinity_alert          = true
# cost_infinity_alert_interval_minutes = 60
# cost_infinity_alert_pending_minutes  = 60

dashboard_defaults = {
  # Use workspace_resource_id from the Azure Terraform stage. It is the telemetry workspace unless
  # telemetry_workspace_resource_id below points elsewhere.
  monitoring_workspace_resource_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/monitoring-rg/providers/Microsoft.OperationalInsights/workspaces/replace-me"
  # If agent telemetry is elsewhere, set telemetry_workspace_resource_id to that workspace's ARM ID.
  foundry_account = {
    resource_group = "foundry-rg"
    name           = "foundry-account"
    region         = "eastus"
  }
  ptu_account = {
    resource_group = "openai-rg"
    name           = "openai-account"
    region         = "eastus"
    deployment     = "replace-with-ptu-deployment"
  }
}
