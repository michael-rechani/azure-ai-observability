subscription_id           = "00000000-0000-0000-0000-000000000000"
resource_group_name       = "monitoring-rg"
create_resource_group     = true
location                  = "eastus"
grafana_admin_object_id   = "00000000-0000-0000-0000-000000000000"
grafana_viewer_principals = {}
notification_email        = "replace-me@example.invalid"
monitored_accounts = {
  foundry = {
    resource_id     = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/foundry-rg/providers/Microsoft.CognitiveServices/accounts/foundry-account"
    ptu_deployments = []
  }
  ptu = {
    resource_id     = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/openai-rg/providers/Microsoft.CognitiveServices/accounts/openai-account"
    ptu_deployments = ["replace-with-ptu-deployment"]
  }
}
existing_telemetry_workspace_ids = []
telemetry_publisher_principals   = {}
enable_agent_alerts              = false
monthly_ai_cost_budget_amount    = 0
enable_cost_pipeline             = false
cost_query_scope                 = "resourceGroupManaged" # Least-privilege default when enabling; requires role-definition permissions.
cost_lookback_days               = 90
# Function-free cost path (export -> storage -> Azure Data Explorer -> Grafana). The ADX cluster bills
# continuously (roughly $95/month at retail). The start date is required when enabled and must stay unchanged.
enable_cost_export = false
# cost_export_start_date = "2026-01-15"
# cost_export_deployer_principal_type = "App" # Default "User"; the identity running Terraform gets AllDatabasesAdmin on the cost cluster.
