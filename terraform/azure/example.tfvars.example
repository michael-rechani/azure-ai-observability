subscription_id           = "00000000-0000-0000-0000-000000000000"
resource_group_name       = "monitoring-rg"
create_resource_group     = true
location                  = "eastus"
grafana_admin_object_id   = "00000000-0000-0000-0000-000000000000"
grafana_viewer_principals = {}
notification_email        = "replace-me@example.invalid"
monitored_accounts = {
  foundry = {
    resource_id     = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/foundry-rg/providers/Microsoft.CognitiveServices/accounts/foundry-account"
    ptu_deployments = []
  }
  ptu = {
    resource_id     = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/openai-rg/providers/Microsoft.CognitiveServices/accounts/openai-account"
    ptu_deployments = ["replace-with-ptu-deployment"]
  }
}
existing_telemetry_workspace_ids = []
telemetry_publisher_principals   = {}
enable_agent_alerts              = false
monthly_ai_cost_budget_amount    = 0
# Billed cost in Grafana: Grafana queries Cost Management directly through the Infinity plugin. It adds no cluster
# or storage, but it is NOT secretless: Terraform creates an app registration, service principal and rotating client
# secret (needs an Entra role that can create applications), and the secret reaches only the Grafana stage through
# the sensitive cost_infinity_client_secret output. Both scopes grant a custom role whose only action is
# Microsoft.CostManagement/query/read; 'resourceGroupManaged' limits it to each monitored resource group.
enable_cost_infinity = false
# cost_infinity_scope                = "resourceGroupManaged" # Or "subscription".
# cost_infinity_secret_rotation_days = 90
